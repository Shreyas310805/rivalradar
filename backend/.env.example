# ---------------------------------------------------------------------------
# RivalRadar backend configuration
#
# Copy to .env and fill in. NEVER commit the real .env file.
# The API key lives ONLY here — never in source, never in the frontend.
# ---------------------------------------------------------------------------

# --- General ---------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# --- Demo mode -------------------------------------------------------------
# false (default) = real competitor tracking only. The database starts empty
#                   and contains nothing until you add a real competitor.
# true            = allows `rivalradar seed` to load FICTIONAL sample
#                   companies, clearly labelled DEMO in the UI.
DEMO_MODE=false

# --- LLM provider ----------------------------------------------------------
# openrouter    - OpenRouter's OpenAI-compatible API (free models available)
# deterministic - no network; rule-based analysis, labelled as such
# openai        - optional, paid, not required
# auto          - openrouter if a key is set, else deterministic
LLM_PROVIDER=openrouter

# --- OpenRouter (free tier) ------------------------------------------------
# Get a key at https://openrouter.ai/keys — free models need no credit card.
# Leave empty to run fully offline: scans still work, and the dashboard will
# honestly report "Analyst: deterministic" rather than claiming AI was used.
OPENROUTER_API_KEY=

# Model slug.
#
# PIN A SPECIFIC FREE MODEL. Do not use the "openrouter/free" router here.
#
# "openrouter/free" picks a DIFFERENT free model on every request, and it can
# land on one that cannot do this task at all — in testing it routed to
# nvidia/nemotron-3.5-content-safety:free, which answered a pricing-analysis
# prompt with "User Safety: safe". A pinned instruct model is reliable; the
# router is a lottery.
#
# Verified working for this task:
#   deepseek/deepseek-v4-flash-0731:free    <- default, recommended
#   nex-agi/nex-n2.5-pro:free
#
# Browse current free models at https://openrouter.ai/models?max_price=0
# (free slugs end in ":free"), then ALWAYS confirm with:
#   rivalradar llm-check
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731:free

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional attribution shown on your OpenRouter dashboard.
OPENROUTER_APP_NAME=RivalRadar
# OPENROUTER_SITE_URL=

# --- LLM cost control ------------------------------------------------------
# Free models are rate limited, so the pipeline is deliberately frugal:
# nothing is sent to the model unless a change survived noise filtering AND
# scored at least LLM_MIN_RELEVANCE, and at most LLM_MAX_CALLS_PER_SCAN
# requests are made per scan.
# Completion token budget. Many free models emit a long hidden reasoning
# block billed against this budget BEFORE any content appears, so a tight
# limit surfaces as an empty completion (finish_reason=length). Raise this
# if llm-check or scans report empty completions.
LLM_MAX_TOKENS=2000
LLM_MAX_CALLS_PER_SCAN=8
LLM_MIN_RELEVANCE=40
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# --- OpenAI (optional, paid — NOT required) --------------------------------
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- Database --------------------------------------------------------------
# LEAVE EMPTY for local development. When unset the app uses an absolute path
# to backend/rivalradar.db, so the same database is found from any working
# directory. A relative URL would create a different file per directory,
# which looks like data loss.
#
# In PRODUCTION this is REQUIRED. With ENVIRONMENT=production and no
# DATABASE_URL the app refuses to start rather than quietly creating a SQLite
# file on an ephemeral container filesystem that is wiped on every restart.
#
# Supabase gives you the string under Project Settings -> Database ->
# Connection string -> URI. Prefer the "Session pooler" / "Transaction
# pooler" host (port 6543) over the direct host (5432): free Render instances
# get a new IP on each restart, and the pooler handles that better.
#
# The legacy postgres:// scheme and a bare postgresql:// are both accepted —
# they are rewritten to postgresql+psycopg:// automatically.
#   DATABASE_URL=postgresql://postgres.abcdefgh:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# --- Scraping --------------------------------------------------------------
SCAN_USER_AGENT=RivalRadar/1.0 (+https://github.com/yourname/rivalradar; competitive-intelligence bot)
REQUEST_TIMEOUT_SECONDS=20
REQUEST_MAX_RETRIES=3
# Minimum delay between requests to the same origin. Be polite.
REQUEST_DELAY_SECONDS=1.5
MAX_RESPONSE_BYTES=5000000
RESPECT_ROBOTS_TXT=true
# SSRF guard. Keep false.
ALLOW_PRIVATE_NETWORKS=false
# JavaScript rendering. Requires:
#   pip install -r requirements-playwright.txt && playwright install chromium
PLAYWRIGHT_ENABLED=false

# --- Scheduler -------------------------------------------------------------
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_MINUTES=360

# --- Wayback ---------------------------------------------------------------
WAYBACK_CDX_URL=https://web.archive.org/cdx/search/cdx
WAYBACK_TIMEOUT_SECONDS=45

# --- CORS ------------------------------------------------------------------
# Comma-separated list of EXACT origins allowed to call this API from a
# browser. Scheme + host + port, no trailing slash, no path.
#
# In production add your GitHub Pages origin, which is the domain only —
# a project site at https://you.github.io/rivalradar/ still has the origin
# https://you.github.io
#   CORS_ORIGINS=https://YOUR_USERNAME.github.io
#
# "*" is rejected outright when ENVIRONMENT=production: this API is not
# authenticated, so any site could otherwise drive it from a visitor's
# browser.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
