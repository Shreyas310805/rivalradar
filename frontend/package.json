    "lucide-react": "^1.47.0",
    "next": "15.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.14",
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "postcss": "8.5.6",
    "tailwindcss": "4.1.14",
    "typescript": "5.9.2"
  }
}
